# Copy to .env for LOCAL DEVELOPMENT ONLY. .env is git-ignored; never commit real values.
# Production reads these from the real environment / a secrets manager, not from a file in the repo.
#
# Generate random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SETTINGS_MODULE=portal_config.settings.development
DJANGO_SECRET_KEY=<generate-a-random-64-char-value>
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only, comma separated https origins:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.test

# Number of trusted reverse proxies in front of Django (0 = ignore X-Forwarded-For entirely).
TRUSTED_PROXY_COUNT=0

# Database. Use postgresql (docker compose) for anything beyond a quick look; sqlite is dev-only.
DB_ENGINE=postgresql
DB_NAME=school_portal
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# Runtime role: DML only, not owner, not superuser (created by deploy/postgres/init).
DB_USER=portal_app
DB_PASSWORD=<generate-a-random-value>
# Migration role: owns the schema; used only by `manage.py migrate` (see DEPLOYMENT.md).
DB_OWNER_USER=portal_owner
DB_OWNER_PASSWORD=<generate-a-random-value>
# PostgreSQL bootstrap superuser for the local container only (never used by the app).
POSTGRES_SUPERUSER_PASSWORD=<generate-a-random-value>

# Redis (required in production for rate limiting)
REDIS_PASSWORD=<generate-a-random-value>
REDIS_URL=redis://:<same-redis-password>@localhost:6379/0

# Private uploads directory (outside any web root)
# PRIVATE_MEDIA_ROOT=/var/lib/school-portal/private-media

# Phase 3 (MFA / HMAC peppers) - placeholders, generated per environment:
# MFA_ENCRYPTION_KEYS=<fernet-key-1>,<older-fernet-key-for-rotation>
# PORTAL_HMAC_KEY=<generate-a-random-value>

# Email (production)
# EMAIL_HOST=smtp.example.test
# EMAIL_PORT=587
# EMAIL_HOST_USER=<smtp-user>
# EMAIL_HOST_PASSWORD=<smtp-password>
DEFAULT_FROM_EMAIL=no-reply@example.test

# Development only: mount the stock Django admin (refused when DEBUG is false).
DJANGO_ADMIN_ENABLED=false
