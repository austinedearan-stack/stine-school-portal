# Environment Mode: development | production | testing
ENVIRONMENT=development

# Security
SECRET_KEY=django-insecure-replace-this-in-production-with-a-cryptographically-strong-secret-key-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Default to SQLite for local development; use PostgreSQL for production
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Production PostgreSQL example:
# DB_ENGINE=postgresql
# DB_NAME=school_portal_db
# DB_USER=portal_app_user
# DB_PASSWORD=your_secure_db_password_here
# DB_HOST=localhost
# DB_PORT=5432

# Redis Cache (Optional for dev, recommended for production rate limiting)
REDIS_URL=redis://127.0.0.1:6379/1

# Security Settings (Production Only)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Media & Static Files
MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles
