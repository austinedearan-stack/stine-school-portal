# Nginx in front of the portal (DEPLOYMENT.md). Rendered by the official nginx image's envsubst step:
# only ${PORTAL_HOST} is substituted (NGINX_ENVSUBST_FILTER), so nginx variables such as $host stay intact.
#
# Responsibilities: TLS termination, HTTP->HTTPS redirect, refusing unknown Host headers, request body
# and header limits, coarse per-IP rate limits (the application enforces its own, finer limits),
# hiding version information, and serving private uploads ONLY after Django authorised them
# (X-Accel-Redirect to an internal location).

server_tokens off;
client_max_body_size 12m;            # = MAX_REQUEST_BYTES (12 MiB); Django rejects larger bodies too
client_body_timeout 15s;
client_header_timeout 15s;
send_timeout 30s;
large_client_header_buffers 4 8k;

limit_req_zone $binary_remote_addr zone=portal_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=portal_general:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=portal_conn:10m;
limit_req_status 429;
limit_conn_status 429;

upstream portal_app {
    server web:8000;
    keepalive 16;
}

# Requests for any other host name are refused (no certificate is presented for them).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 444;
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${PORTAL_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${PORTAL_HOST};

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    # Mozilla "intermediate" profile.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:portal_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    limit_conn portal_conn 50;
    keepalive_timeout 30s;   # server level: the image's nginx.conf already sets it in http {}

    # Security headers (HSTS, CSP, frame, referrer, nosniff) are set by Django on every response.
    # Nginx drops the upstream Server header; with server_tokens off it only says "nginx".
    proxy_hide_header X-Powered-By;

    # Never serve dotfiles or source/backup artefacts, whatever the application would do.
    location ~ /\.(?!well-known/) { return 404; }
    location ~* \.(py|pyc|sql|sqlite3|dump|bak|env|ini|cfg|toml|log)$ { return 404; }

    # Sign-in, MFA and password reset: tight per-IP rate on top of the application's throttles.
    location ~ ^/accounts/(login|mfa|password/reset)/ {
        limit_req zone=portal_auth burst=10 nodelay;
        include /etc/nginx/templates/proxy_params.inc;
    }

    location / {
        limit_req zone=portal_general burst=40 nodelay;
        include /etc/nginx/templates/proxy_params.inc;
    }

    # Private uploads. "internal": reachable only through an X-Accel-Redirect issued by Django after
    # its authorization check (PRIVATE_FILES_X_ACCEL_PREFIX=/_protected/). A direct request is a 404.
    # add_header replaces inherited headers, so the protective headers are repeated here; nginx keeps
    # the upstream Content-Type, Content-Disposition and Cache-Control on the internal redirect.
    location /_protected/ {
        internal;
        alias /srv/private-media/;
        autoindex off;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox" always;
        add_header Cache-Control "private, no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
    }
}
