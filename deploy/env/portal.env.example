# /etc/school-portal/portal.env - runtime settings for web, scheduler, migrate and backup (DEPLOYMENT.md).
# Copy, fill in, then: chown root:root portal.env && chmod 600 portal.env. Never commit the real file.
# Generate random values with: python -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SECRET_KEY=<generate-64-random-chars>
# During a rotation only: the previous key(s), comma separated (DEPLOYMENT.md "Secret rotation").
# DJANGO_SECRET_KEY_FALLBACKS=<previous-secret-key>
DJANGO_ALLOWED_HOSTS=<portal.example.ac.ke>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<portal.example.ac.ke>

# MFA secret encryption (first key encrypts, all decrypt). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEYS=<fernet-key>
# Keyed hashing of one-time codes, device cookies and identifiers (>= 32 chars, not the secret key).
PORTAL_HMAC_KEY=<generate-64-random-chars>
# PORTAL_HMAC_KEY_FALLBACKS=<previous-hmac-key>

# Database: the RUNTIME role (DML only). The owner role is only in owner.env.
DB_ENGINE=postgresql
DB_NAME=school_portal
DB_USER=portal_app
DB_PASSWORD=<portal_app-password>

REDIS_URL=redis://:<redis-password>@redis:6379/0

EMAIL_HOST=<smtp.example.ac.ke>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
DEFAULT_FROM_EMAIL=<no-reply@example.ac.ke>
SECURITY_CONTACT=<mailto:security@example.ac.ke>

# HSTS preload only once every subdomain is permanently HTTPS (hard to undo).
SECURE_HSTS_PRELOAD=false
