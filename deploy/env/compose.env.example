# /etc/school-portal/compose.env - non-secret values interpolated into docker-compose.prod.yml.
#   docker compose -f docker-compose.prod.yml --env-file /etc/school-portal/compose.env up -d
PORTAL_HOST=<portal.example.ac.ke>
PORTAL_IMAGE=<registry.example.ac.ke/school-portal:2026.10.0>
PORTAL_OPS_IMAGE=<registry.example.ac.ke/school-portal-ops:2026.10.0>
PORTAL_ENV_FILE=/etc/school-portal/portal.env
PORTAL_OWNER_ENV_FILE=/etc/school-portal/owner.env
PORTAL_BACKUP_ENV_FILE=/etc/school-portal/backup.env
PORTAL_DB_ENV_FILE=/etc/school-portal/db.env
PORTAL_REDIS_ENV_FILE=/etc/school-portal/redis.env
PORTAL_TLS_DIR=/etc/school-portal/tls
PORTAL_ACME_DIR=/var/www/acme
