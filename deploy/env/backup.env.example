# /etc/school-portal/backup.env - only for the backup service (BACKUP_AND_RESTORE.md). chmod 600.
# pg_dump runs as the schema owner so it can read every table and sequence.
BACKUP_DB_USER=portal_owner
BACKUP_DB_PASSWORD=<portal_owner-password>
BACKUP_KEEP=14
# The restore test creates/drops <DB_NAME>_restore_test with this CREATEDB-only role.
RESTORE_DB_USER=portal_restore
RESTORE_DB_PASSWORD=<portal_restore-password>
