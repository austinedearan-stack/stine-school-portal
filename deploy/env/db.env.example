# /etc/school-portal/db.env - read by the PostgreSQL container on FIRST start only (deploy/postgres/init).
# chmod 600. The bootstrap superuser is never used by the application.
POSTGRES_PASSWORD=<bootstrap-superuser-password>
DB_NAME=school_portal
DB_OWNER_USER=portal_owner
DB_OWNER_PASSWORD=<portal_owner-password>
DB_USER=portal_app
DB_PASSWORD=<portal_app-password>
DB_RESTORE_USER=portal_restore
DB_RESTORE_PASSWORD=<portal_restore-password>
